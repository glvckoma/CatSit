<Window x:Class="CatSit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CatSit.UI"
        Title="CatSit Settings"
        Width="720" Height="580"
        MinWidth="640" MinHeight="480"
        Background="{StaticResource Backdrop}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,16" />
                <ListBox x:Name="SectionList"
                         SelectedIndex="0"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnSectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Shell" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentSoft}" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="General">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconPath Geometry="{StaticResource IconLock}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Size="17" />
                            <TextBlock Text="General" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Detection">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconPath Geometry="{StaticResource IconSliders}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Size="17" />
                            <TextBlock Text="Detection" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Cat">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconPath Geometry="{StaticResource IconCat}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Size="17" />
                            <TextBlock Text="Cat" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Sounds">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconPath Geometry="{StaticResource IconVolume}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Size="17" />
                            <TextBlock Text="Sounds" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Activity">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconPath Geometry="{StaticResource IconActivity}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Size="17" />
                            <TextBlock Text="Activity" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,22">
            <Grid>
                <StackPanel x:Name="GeneralPanel">
                    <TextBlock Text="What gets locked" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Lock keyboard" IsChecked="{Binding LockKeyboard}" />
                    <CheckBox Content="Lock mouse" IsChecked="{Binding LockMouse}" />
                    <TextBlock Text="At least one input must stay selected." Style="{StaticResource Caption}" Margin="0,2,0,18" />

                    <TextBlock Text="Shortcut" Style="{StaticResource SectionTitle}" />
                    <ui:HotkeyCaptureBox Combo="{Binding ToggleHotkey}"
                                         Width="220"
                                         HorizontalAlignment="Left"
                                         Padding="10,7"
                                         Background="{StaticResource SurfaceRaised}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource Stroke}"
                                         CaretBrush="Transparent" />
                    <TextBlock Text="Click the box and press a combination with at least one modifier." Style="{StaticResource Caption}" Margin="0,6,0,18" />

                    <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Show unlock hint on screen" IsChecked="{Binding ShowUnlockHint}" />
                    <CheckBox Content="Click the cat to dismiss it" IsChecked="{Binding ClickToDismiss}" />
                    <CheckBox Content="Tray notification when a cat is detected" IsChecked="{Binding ShowTrayAlerts}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Auto-unlock after" VerticalAlignment="Center" Width="120" />
                        <Slider Style="{StaticResource TickSlider}" Width="220" Minimum="0" Maximum="60" TickFrequency="5"
                                Value="{Binding AutoUnlockMinutes}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutoUnlockText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="DetectionPanel" Visibility="Collapsed">
                    <TextBlock Text="Cat detection" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Detect cats automatically" IsChecked="{Binding DetectionEnabled}" />
                    <CheckBox Content="Warn only, do not lock" IsChecked="{Binding WarnOnly}" />
                    <CheckBox Content="Pause detection while a fullscreen app is active" IsChecked="{Binding PauseInFullscreen}" />
                    <CheckBox Content="Learn from my feedback" IsChecked="{Binding LearningEnabled}" />
                    <TextBlock Text="{Binding LearningStatus}" Style="{StaticResource Caption}" Margin="0,2,0,20" TextWrapping="Wrap" />

                    <TextBlock Text="Sensitivity" Style="{StaticResource SectionTitle}" />
                    <Slider Style="{StaticResource TickSlider}"
                            Minimum="1" Maximum="10"
                            Value="{Binding Sensitivity}"
                            Width="320"
                            HorizontalAlignment="Left" />
                    <Grid Width="320" HorizontalAlignment="Left" Margin="0,2,0,0">
                        <TextBlock Text="Relaxed" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                        <TextBlock Text="Twitchy" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding SensitivityExplanation}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Width="420" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="CatPanel" Visibility="Collapsed">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Left" Padding="18,14" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding CatPreview}" Width="160" Height="120"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Breed" Style="{StaticResource Caption}" />
                                <ComboBox Width="180" Margin="0,4,0,12"
                                          ItemsSource="{Binding Breeds}"
                                          SelectedItem="{Binding SelectedBreed}"
                                          DisplayMemberPath="Name" />
                                <CheckBox Content="Custom fur color" IsChecked="{Binding UseCustomFur}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding UseCustomFur}">
                                    <Border Width="30" Height="30" CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            Background="{Binding CustomFurBrush}" />
                                    <Button Content="Pick color" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Click="OnPickFurColor" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Size" Style="{StaticResource SectionTitle}" />
                    <Slider Style="{StaticResource TickSlider}" Minimum="2" Maximum="8" Value="{Binding CatScale}"
                            Width="240" HorizontalAlignment="Left" />
                    <Grid Width="240" HorizontalAlignment="Left" Margin="0,2,0,18">
                        <TextBlock Text="Small" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                        <TextBlock Text="Large" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Walks in from" VerticalAlignment="Center" Width="120" />
                        <ComboBox Width="160" ItemsSource="{Binding Edges}" SelectedItem="{Binding SelectedEdge}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Sleeps after" VerticalAlignment="Center" Width="120" />
                        <Slider Style="{StaticResource TickSlider}" Width="240" Minimum="3" Maximum="60" TickFrequency="3"
                                Value="{Binding SecondsUntilSleep}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SleepDelayText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <CheckBox Content="Show Zzz while sleeping" IsChecked="{Binding ShowZzz}" />
                </StackPanel>

                <StackPanel x:Name="SoundsPanel" Visibility="Collapsed">
                    <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Play sounds" IsChecked="{Binding SoundsEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20" IsEnabled="{Binding SoundsEnabled}">
                        <TextBlock Text="Volume" VerticalAlignment="Center" Width="110" />
                        <Slider Style="{StaticResource TickSlider}" Width="240" Minimum="0" Maximum="100" TickFrequency="10"
                                Value="{Binding Volume}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel IsEnabled="{Binding SoundsEnabled}">
                        <TextBlock Text="When input locks" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox Width="180" ItemsSource="{Binding LockSounds}" SelectedItem="{Binding SelectedLockSound}" DisplayMemberPath="Name" />
                            <Button Content="Play" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnPreviewLock" />
                            <Button Content="Choose file" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnPickLockFile" />
                        </StackPanel>
                        <TextBlock Text="{Binding LockSoundPathText}" Style="{StaticResource Caption}" Margin="0,0,0,18" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />

                        <TextBlock Text="When the cat is clicked" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox Width="180" ItemsSource="{Binding CatSounds}" SelectedItem="{Binding SelectedCatSound}" DisplayMemberPath="Name" />
                            <Button Content="Play" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnPreviewCat" />
                            <Button Content="Choose file" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnPickCatFile" />
                        </StackPanel>
                        <TextBlock Text="{Binding CatSoundPathText}" Style="{StaticResource Caption}" Margin="0,0,0,18" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />

                        <TextBlock Text="Deterrent when a cat is detected" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox Width="180" ItemsSource="{Binding DeterrentSounds}" SelectedItem="{Binding SelectedDeterrentSound}" DisplayMemberPath="Name" />
                            <Button Content="Play" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnPreviewDeterrent" />
                            <Button Content="Choose file" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnPickDeterrentFile" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeterrentSoundPathText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ActivityPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Recent triggers" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="Clear history" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClearActivity" />
                    </Grid>
                    <TextBlock Text="Mark anything that was not your cat and CatSit will stop triggering on that key combination."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <ItemsControl ItemsSource="{Binding Triggers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Headline}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VerdictText}"
                                                       Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       Visibility="{Binding VerdictVisibility}" />
                                            <Button Content="Was a cat" Style="{StaticResource GhostButton}"
                                                    Visibility="{Binding ButtonsVisibility}"
                                                    Command="{Binding ConfirmCommand}" />
                                            <Button Content="Not a cat" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                    Visibility="{Binding ButtonsVisibility}"
                                                    Command="{Binding RejectCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No triggers recorded yet."
                               Style="{StaticResource Caption}"
                               Visibility="{Binding EmptyActivityVisibility}"
                               Margin="0,6,0,0" />

                    <TextBlock Text="Ignored combinations" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        CornerRadius="9" Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Signature}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="8,0,0,0"
                                                ToolTip="Stop ignoring this combination"
                                                Command="{Binding RemoveCommand}">
                                            <ui:IconPath Geometry="{StaticResource IconClose}" Foreground="{StaticResource TextSecondary}" Size="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing ignored yet."
                               Style="{StaticResource Caption}"
                               Visibility="{Binding EmptyExclusionsVisibility}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
