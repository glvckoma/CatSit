<Window x:Class="CatSit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CatSit.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CatSit"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="{StaticResource Backdrop}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <DockPanel>
            <ui:WindowHeader DockPanel.Dock="Top" HeaderTitle="CatSit" />
            <StackPanel Margin="22,18,22,22">
            <Grid Margin="0,0,0,12">
                <TextBlock Text="{Binding ModeSummary}"
                           Style="{StaticResource Caption}"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Settings"
                        Click="OnSettingsClicked">
                    <ui:IconPath Geometry="{StaticResource IconCog}"
                                 Foreground="{StaticResource TextSecondary}"
                                 Size="20" />
                </Button>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="20,18">
                <StackPanel>
                    <Border CornerRadius="20" Padding="12,5" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Image Source="{Binding CatPreview}"
                           Width="160" Height="120"
                           Margin="0,10,0,8"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <Button Command="{Binding ToggleLockCommand}"
                            Content="{Binding ToggleButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,4,0,10" />

                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}">
                        <Run Text="Shortcut" />
                        <Run Text="{Binding HotkeyText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetectionSummary}" FontSize="13" />
                        <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="Activity"
                            VerticalAlignment="Center"
                            Click="OnActivityClicked" />
                </Grid>
            </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
