<Window x:Class="CatSit.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CatSit Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Grid>
        <Canvas x:Name="ZzzCanvas" IsHitTestVisible="False" />
        <Canvas x:Name="CatCanvas">
            <Image x:Name="CatImage"
                   Width="128"
                   Height="96"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Cursor="Hand"
                   MouseLeftButtonDown="OnCatClicked" />
        </Canvas>
        <Border x:Name="HintBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Background="#E61A1D27"
                BorderBrush="#556FD3B8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,9"
                IsHitTestVisible="False">
            <TextBlock x:Name="HintText"
                       Foreground="#E8EDF5"
                       FontSize="16"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
